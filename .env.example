POD_TRACKER_ADDR=:8080
POD_TRACKER_ENV=development
POD_TRACKER_STATIC_DIR=crates/pod-web/assets

POD_TRACKER_DATABASE_URL=postgres://pod_tracker:pod_tracker@localhost:5432/pod_tracker?sslmode=disable

# Optional: use a local admin/superuser URL for migrations that create
# extensions such as pg_stat_statements.
# POD_TRACKER_MIGRATION_DATABASE_URL=postgres://sawyer@localhost:5432/pod_tracker?sslmode=disable

# SMTP2GO is the approved transactional email provider for auth email.
# Put the real API key only in ignored local/production env files.
# SMTP2GO_API_KEY=
# POD_TRACKER_EMAIL_FROM=Pod Tracker <noreply@example.test>
# POD_TRACKER_EMAIL_REPLY_TO=support@example.test

# TypeScript rewrite abuse protection. Use the Valkey service in
# compose.yaml for production-like local checks.
# VALKEY_URL=redis://localhost:6379/0
