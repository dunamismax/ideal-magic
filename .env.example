NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev_only_change_me_replace_for_production

POD_TRACKER_DATABASE_URL=postgres://pod_tracker:pod_tracker@localhost:55432/pod_tracker?sslmode=disable

# Optional: use a local admin/superuser URL for migrations.
# POD_TRACKER_MIGRATION_DATABASE_URL=postgres://pod_tracker:pod_tracker@localhost:55432/pod_tracker?sslmode=disable

# SMTP2GO is the approved transactional email provider for auth email.
# Put the real API key only in ignored local/production env files.
# SMTP2GO_API_KEY=
# POD_TRACKER_EMAIL_FROM=Pod Tracker <noreply@example.test>
# POD_TRACKER_EMAIL_REPLY_TO=support@example.test

# TypeScript rewrite abuse protection. Use the Valkey service in
# compose.yaml for production-like local checks.
# VALKEY_URL=redis://localhost:6379/0
