NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000

NEXT_PUBLIC_APP_URL=https://pod-tracker.app
BETTER_AUTH_URL=https://pod-tracker.app
BETTER_AUTH_SECRET=change_me_with_a_long_random_secret

# Runtime role. Keep this less privileged than the migration role.
POD_TRACKER_DATABASE_URL=postgres://pod_tracker:CHANGE_ME@127.0.0.1:5432/pod_tracker?sslmode=disable

# Migration/admin role for Drizzle migrations.
POD_TRACKER_MIGRATION_DATABASE_URL=postgres://pod_tracker_migrator:CHANGE_ME@127.0.0.1:5432/pod_tracker?sslmode=disable

# Transactional auth email.
SMTP2GO_API_KEY=your_smtp2go_api_key_here
POD_TRACKER_EMAIL_FROM=Pod Tracker <noreply@pod-tracker.app>
# POD_TRACKER_EMAIL_REPLY_TO=support@pod-tracker.app

# Required in production when rate-limited routes are enabled.
VALKEY_URL=redis://127.0.0.1:6379/0

# Optional GlitchTip/Sentry-compatible error reporting. Leave unset to
# disable. The app reports controlled event names and error class names,
# not request payloads.
# POD_TRACKER_ERROR_REPORTING_DSN=https://PUBLIC_KEY@glitchtip.example.test/PROJECT_ID
POD_TRACKER_ERROR_REPORTING_ENVIRONMENT=production
# POD_TRACKER_RELEASE=2026.06.06

# Optional Umami custom events. Leave unset to disable. Server-side event
# tracking sends coarse action names only and does not send tokenized
# routes, referrers, IDs, notes, addresses, or event data payloads.
# POD_TRACKER_UMAMI_API_URL=https://umami.example.test/api/send
# POD_TRACKER_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
POD_TRACKER_UMAMI_HOSTNAME=pod-tracker.app

# Optional comma-separated list when the same deployment accepts requests
# through additional trusted HTTPS origins.
# POD_TRACKER_TRUSTED_ORIGINS=https://www.pod-tracker.app
